PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Optional for the public demo; both are required for authenticated persistence.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required together for Google Calendar connection. DATABASE_URL must be a
# server-only direct PostgreSQL connection with access to the private schema.
DATABASE_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Use http://localhost:3001/api/calendar/callback for local development.
GOOGLE_OAUTH_REDIRECT_URI=
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
