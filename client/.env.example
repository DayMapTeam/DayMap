# Copy to .env.local and supply your website-restricted Google Maps browser key.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: google (default when a key exists), or demo for simulated demo-day travel.
# Live plans always require Google; failures never fall back to simulation.
VITE_TRAVEL_PROVIDER=google
# Optional: sign-in and saved days. Use the shared Supabase project's URL and
# publishable key (never a secret key). Without them DayMap shows the demo day.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: Express API origin when it is not served from the same origin.
# Leave empty in development; Vite proxies /api to http://localhost:3001.
VITE_API_BASE_URL=
